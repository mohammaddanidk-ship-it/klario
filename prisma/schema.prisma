generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

model Explanation {
  id          String   @id @default(cuid())
  slug        String   @unique
  docType     String   @unique
  explanation String
  snippets    String   @default("[]")
  language    String   @default("English")
  views       Int      @default(0)
  count       Int      @default(1)
  isPhishing  Boolean  @default(false)
  verdict     String?
  confidence  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([docType])
  @@index([isPhishing])
  @@index([views])
}

model UsageLog {
  id           String   @id @default(cuid())
  endpoint     String   // "explain" | "shield" | "followup"
  success      Boolean  @default(true)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  estimatedCostCents Float @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([success])
  @@index([endpoint])
}