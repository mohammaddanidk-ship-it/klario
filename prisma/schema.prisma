generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

model Explanation {
  id          String   @id @default(cuid())
  slug        String   @unique
  docType     String   @unique
  explanation String
  snippets    String   @default("[]")
  language    String   @default("English")
  views       Int      @default(0)
  count       Int      @default(1)
  isPhishing  Boolean  @default(false)
  verdict     String?
  confidence  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([docType])
  @@index([isPhishing])
  @@index([views])
}